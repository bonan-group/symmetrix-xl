#pragma once

// Generated by CMake from SpheriCart's include/macros.hpp. Only the hardcoded
// polynomial macros are copied; the C++ remove_pointer helper they normally
// use for literal casts is not valid MSL, so cast() is redefined for FP32.

namespace symmetrix::execution::metal {

inline constexpr const char sphericart_macros_msl[] = R"SPHERICART(
#pragma clang diagnostic ignored "-Wc++17-extensions"
#define SPHERICART_LMAX_HARDCODED 6
#define cast(sph, lit) float(lit)
@SYMMETRIX_METAL_SPHERICART_MACROS@
)SPHERICART";

}  // namespace symmetrix::execution::metal
