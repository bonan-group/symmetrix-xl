@@ -0,0 +1,235 @@
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <cuda_runtime_api.h>
+
+#include "sphericart_cuda.hpp"
+
+#define CUDA_CHECK(call)                                                                          \
+    do {                                                                                          \
+        const cudaError_t status = (call);                                                        \
+        if (status != cudaSuccess) {                                                              \
+            std::cerr << #call << " failed: " << cudaGetErrorString(status) << std::endl;         \
+            return 1;                                                                             \
+        }                                                                                         \
+    } while (0)
+
+int main() {
+    using Calculator = sphericart::cuda::SphericalHarmonics<double>;
+    static_assert(
+        !noexcept(std::declval<Calculator&>().release_device_resources()),
+        "release_device_resources must report CUDA runtime failures"
+    );
+
+    int device_count = 0;
+    const cudaError_t count_status = cudaGetDeviceCount(&device_count);
+    if (count_status != cudaSuccess || device_count == 0) {
+        std::cout << "No CUDA device; skipping async CUDA API test" << std::endl;
+        return 0;
+    }
+
+    constexpr size_t l_max = 3;
+    constexpr size_t n_samples = 256;
+    constexpr size_t n_spherical = (l_max + 1) * (l_max + 1);
+    const size_t xyz_size = 3 * n_samples;
+    const size_t sph_size = n_samples * n_spherical;
+    const size_t dsph_size = 3 * sph_size;
+
+    std::vector<double> xyz(xyz_size);
+    for (size_t sample = 0; sample < n_samples; ++sample) {
+        xyz[3 * sample] = 0.25 + 0.001 * static_cast<double>(sample);
+        xyz[3 * sample + 1] = -0.5 + 0.002 * static_cast<double>(sample);
+        xyz[3 * sample + 2] = 0.75 - 0.0015 * static_cast<double>(sample);
+    }
+    std::vector<double> async_sph(sph_size);
+    std::vector<double> async_dsph(dsph_size);
+    std::vector<double> sync_sph(sph_size);
+    std::vector<double> sync_dsph(dsph_size);
+    std::vector<double> blocked_sph(sph_size);
+    std::vector<double> blocked_dsph(dsph_size);
+    std::vector<double> recreated_sph(sph_size);
+    std::vector<double> recreated_dsph(dsph_size);
+
+    double* device_xyz = nullptr;
+    double* device_sph = nullptr;
+    double* device_dsph = nullptr;
+    cudaStream_t stream = nullptr;
+    cudaStream_t gate_stream = nullptr;
+    cudaStream_t probe_stream = nullptr;
+    cudaEvent_t gate = nullptr;
+    CUDA_CHECK(cudaSetDevice(0));
+    CUDA_CHECK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+    CUDA_CHECK(cudaStreamCreateWithFlags(&gate_stream, cudaStreamNonBlocking));
+    CUDA_CHECK(cudaStreamCreateWithFlags(&probe_stream, cudaStreamNonBlocking));
+    CUDA_CHECK(cudaEventCreateWithFlags(&gate, cudaEventDisableTiming));
+    CUDA_CHECK(cudaMalloc(reinterpret_cast<void**>(&device_xyz), xyz_size * sizeof(double)));
+    CUDA_CHECK(cudaMalloc(reinterpret_cast<void**>(&device_sph), sph_size * sizeof(double)));
+    CUDA_CHECK(cudaMalloc(reinterpret_cast<void**>(&device_dsph), dsph_size * sizeof(double)));
+    CUDA_CHECK(cudaMemcpyAsync(
+        device_xyz, xyz.data(), xyz_size * sizeof(double), cudaMemcpyHostToDevice, stream
+    ));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+
+    Calculator calculator(l_max);
+    calculator.release_device_resources();
+    calculator.release_device_resources();
+    calculator.compute_with_gradients(
+        device_xyz,
+        n_samples,
+        device_sph,
+        device_dsph,
+        reinterpret_cast<void*>(stream)
+    );
+    CUDA_CHECK(cudaMemcpy(
+        sync_sph.data(), device_sph, sph_size * sizeof(double), cudaMemcpyDeviceToHost
+    ));
+    CUDA_CHECK(cudaMemcpy(
+        sync_dsph.data(), device_dsph, dsph_size * sizeof(double), cudaMemcpyDeviceToHost
+    ));
+
+    CUDA_CHECK(cudaMemsetAsync(device_sph, 0, sph_size * sizeof(double), probe_stream));
+    CUDA_CHECK(cudaMemsetAsync(device_dsph, 0, dsph_size * sizeof(double), probe_stream));
+    CUDA_CHECK(cudaStreamSynchronize(probe_stream));
+    CUDA_CHECK(cudaLaunchHostFunc(
+        gate_stream,
+        [](void*) { std::this_thread::sleep_for(std::chrono::milliseconds(500)); },
+        nullptr
+    ));
+    CUDA_CHECK(cudaEventRecord(gate, gate_stream));
+    CUDA_CHECK(cudaStreamWaitEvent(stream, gate, 0));
+
+    const auto async_start = std::chrono::steady_clock::now();
+    calculator.compute_with_gradients_async(
+        device_xyz,
+        n_samples,
+        device_sph,
+        device_dsph,
+        reinterpret_cast<void*>(stream)
+    );
+    const auto async_elapsed = std::chrono::steady_clock::now() - async_start;
+    if (async_elapsed >= std::chrono::milliseconds(250)) {
+        std::cerr << "Asynchronous CUDA call waited for blocked stream work" << std::endl;
+        return 1;
+    }
+    if (cudaEventQuery(gate) != cudaErrorNotReady) {
+        std::cerr << "CUDA stream gate completed before the async call returned" << std::endl;
+        return 1;
+    }
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    CUDA_CHECK(cudaMemcpyAsync(
+        blocked_sph.data(), device_sph, sph_size * sizeof(double),
+        cudaMemcpyDeviceToHost, probe_stream
+    ));
+    CUDA_CHECK(cudaMemcpyAsync(
+        blocked_dsph.data(), device_dsph, dsph_size * sizeof(double),
+        cudaMemcpyDeviceToHost, probe_stream
+    ));
+    CUDA_CHECK(cudaStreamSynchronize(probe_stream));
+    if (std::any_of(blocked_sph.begin(), blocked_sph.end(), [](double value) {
+            return value != 0.0;
+        }) || std::any_of(blocked_dsph.begin(), blocked_dsph.end(), [](double value) {
+            return value != 0.0;
+        })) {
+        std::cerr << "Asynchronous CUDA kernel did not honor the supplied stream" << std::endl;
+        return 1;
+    }
+
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaMemcpy(
+        async_sph.data(), device_sph, sph_size * sizeof(double), cudaMemcpyDeviceToHost
+    ));
+    CUDA_CHECK(cudaMemcpy(
+        async_dsph.data(), device_dsph, dsph_size * sizeof(double), cudaMemcpyDeviceToHost
+    ));
+
+    if (async_sph != sync_sph || async_dsph != sync_dsph) {
+        std::cerr << "Asynchronous and synchronous CUDA results differ" << std::endl;
+        return 1;
+    }
+
+    if (device_count > 1) {
+        CUDA_CHECK(cudaSetDevice(1));
+        calculator.release_device_resources();
+        calculator.release_device_resources();
+
+        int restored_device = -1;
+        CUDA_CHECK(cudaGetDevice(&restored_device));
+        if (restored_device != 1) {
+            std::cerr << "Resource release did not restore the caller's CUDA device" << std::endl;
+            return 1;
+        }
+
+        double* other_xyz = nullptr;
+        double* other_sph = nullptr;
+        double* other_dsph = nullptr;
+        cudaStream_t other_stream = nullptr;
+        CUDA_CHECK(cudaStreamCreateWithFlags(&other_stream, cudaStreamNonBlocking));
+        CUDA_CHECK(cudaMalloc(reinterpret_cast<void**>(&other_xyz), xyz_size * sizeof(double)));
+        CUDA_CHECK(cudaMalloc(reinterpret_cast<void**>(&other_sph), sph_size * sizeof(double)));
+        CUDA_CHECK(cudaMalloc(reinterpret_cast<void**>(&other_dsph), dsph_size * sizeof(double)));
+
+        bool migration_rejected = false;
+        try {
+            calculator.compute_with_gradients_async(
+                other_xyz,
+                n_samples,
+                other_sph,
+                other_dsph,
+                reinterpret_cast<void*>(other_stream)
+            );
+        } catch (const std::runtime_error& error) {
+            migration_rejected =
+                std::string(error.what()).find("device migration is unsupported") != std::string::npos;
+        }
+        if (!migration_rejected) {
+            std::cerr << "Calculator accepted migration to another CUDA device" << std::endl;
+            return 1;
+        }
+
+        CUDA_CHECK(cudaFree(other_dsph));
+        CUDA_CHECK(cudaFree(other_sph));
+        CUDA_CHECK(cudaFree(other_xyz));
+        CUDA_CHECK(cudaStreamDestroy(other_stream));
+        CUDA_CHECK(cudaSetDevice(0));
+    } else {
+        calculator.release_device_resources();
+        calculator.release_device_resources();
+    }
+    calculator.compute_with_gradients_async(
+        device_xyz,
+        n_samples,
+        device_sph,
+        device_dsph,
+        reinterpret_cast<void*>(stream)
+    );
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaMemcpy(
+        recreated_sph.data(), device_sph, sph_size * sizeof(double), cudaMemcpyDeviceToHost
+    ));
+    CUDA_CHECK(cudaMemcpy(
+        recreated_dsph.data(), device_dsph, dsph_size * sizeof(double), cudaMemcpyDeviceToHost
+    ));
+    if (recreated_sph != sync_sph || recreated_dsph != sync_dsph) {
+        std::cerr << "CUDA results differ after resource recreation" << std::endl;
+        return 1;
+    }
+    calculator.release_device_resources();
+    calculator.release_device_resources();
+
+    CUDA_CHECK(cudaFree(device_dsph));
+    CUDA_CHECK(cudaFree(device_sph));
+    CUDA_CHECK(cudaFree(device_xyz));
+    CUDA_CHECK(cudaEventDestroy(gate));
+    CUDA_CHECK(cudaStreamDestroy(probe_stream));
+    CUDA_CHECK(cudaStreamDestroy(gate_stream));
+    CUDA_CHECK(cudaStreamDestroy(stream));
+    return 0;
+}
