diff --git a/sphericart/tests/test_cuda_stub_api.cpp b/sphericart/tests/test_cuda_stub_api.cpp
new file mode 100644
index 0000000..dd8784d
--- /dev/null
+++ b/sphericart/tests/test_cuda_stub_api.cpp
@@ -0,0 +1,30 @@
+#include <iostream>
+#include <stdexcept>
+#include <utility>
+
+#include "sphericart_cuda.hpp"
+
+int main() {
+    using Calculator = sphericart::cuda::SphericalHarmonics<double>;
+    static_assert(
+        !noexcept(std::declval<Calculator&>().release_device_resources()),
+        "release_device_resources must report CUDA runtime failures"
+    );
+
+    Calculator calculator(1);
+    calculator.release_device_resources();
+    calculator.release_device_resources();
+
+    bool unavailable = false;
+    try {
+        calculator.compute_with_gradients_async(nullptr, 1, nullptr, nullptr);
+    } catch (const std::runtime_error&) {
+        unavailable = true;
+    }
+
+    if (!unavailable) {
+        std::cerr << "CUDA stub async API did not report unavailable CUDA support" << std::endl;
+        return 1;
+    }
+    return 0;
+}
