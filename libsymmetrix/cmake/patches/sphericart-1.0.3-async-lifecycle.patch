+template <typename T> void SphericalHarmonics<T>::release_device_resources() {
+    if (this->prefactors_cuda == nullptr) {
+        return;
+    }
+
+    int current_device;
+    CUDART_SAFE_CALL(CUDART_INSTANCE.cudaGetDevice(&current_device));
+    if (this->bound_device < 0) {
+        throw std::runtime_error(
+            "sphericart CUDA calculator has allocated prefactors without a bound device"
+        );
+    }
+
+    const bool restore_device = current_device != this->bound_device;
+    if (restore_device) {
+        CUDART_SAFE_CALL(CUDART_INSTANCE.cudaSetDevice(this->bound_device));
+    }
+
+    const cudaError_t free_status = CUDART_INSTANCE.cudaFree(this->prefactors_cuda);
+    if (free_status == cudaSuccess) {
+        this->prefactors_cuda = nullptr;
+    }
+
+    cudaError_t restore_status = cudaSuccess;
+    if (restore_device) {
+        restore_status = CUDART_INSTANCE.cudaSetDevice(current_device);
+    }
+
+    CUDART_SAFE_CALL(free_status);
+    CUDART_SAFE_CALL(restore_status);
+}
+
