#pragma once

// Configured build identity for the module initializer.  Keep these values in
// this header, which is included only by symmetrix.cpp: putting them on a
// source COMPILE_DEFINITIONS property makes Unix Makefiles place them in the
// target-wide flags.make and recompiles every binding translation unit when
// provenance changes.
#define SYMMETRIX_PYTHON_MODULE @SYMMETRIX_PYTHON_MODULE_NAME@
#define SYMMETRIX_NATIVE_ABI 1
#define SYMMETRIX_BUILD_BACKEND "@SYMMETRIX_BACKEND_SELECTOR@"
#define SYMMETRIX_BUILD_ARCHITECTURE "@SYMMETRIX_BACKEND_ARCHITECTURE@"
#define SYMMETRIX_BUILD_DISTRIBUTION "@SYMMETRIX_DISTRIBUTION_NAME@"
#define SYMMETRIX_BUILD_SOURCE_COMMIT "@SYMMETRIX_BUILD_SOURCE_COMMIT@"
#define SYMMETRIX_BUILD_SOURCE_DIRTY @SYMMETRIX_BUILD_SOURCE_DIRTY@
#define SYMMETRIX_BUILD_SOURCE_CONTENT_SHA256 "@SYMMETRIX_BUILD_SOURCE_CONTENT_SHA256@"
#define SYMMETRIX_BUILD_NATIVE_SOURCE_CONTENT_SHA256 "@SYMMETRIX_BUILD_NATIVE_SOURCE_CONTENT_SHA256@"
#define SYMMETRIX_BUILD_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@"
#define SYMMETRIX_BUILD_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@"
#define SYMMETRIX_BUILD_DEVICE_COMPILER_ID "@SYMMETRIX_BUILD_DEVICE_COMPILER_ID@"
#define SYMMETRIX_BUILD_DEVICE_COMPILER_VERSION "@SYMMETRIX_BUILD_DEVICE_COMPILER_VERSION@"
#cmakedefine01 SYMMETRIX_BUILD_FAST_MATH
#cmakedefine01 SYMMETRIX_PARTICLE_MESH_AVAILABLE
#define SYMMETRIX_PARTICLE_MESH_PROVIDER "@SYMMETRIX_PARTICLE_MESH_PROVIDER@"
#define SYMMETRIX_PARTICLE_MESH_PROVIDER_VARIANT "@SYMMETRIX_PARTICLE_MESH_PROVIDER_VARIANT@"
#define SYMMETRIX_PARTICLE_MESH_KOKKOSFFT_VERSION "@SYMMETRIX_PARTICLE_MESH_KOKKOSFFT_VERSION@"
#define SYMMETRIX_PARTICLE_MESH_REASON "@SYMMETRIX_PARTICLE_MESH_REASON@"
#cmakedefine01 SYMMETRIX_FOURIER_D3_AVAILABLE
#define SYMMETRIX_FOURIER_D3_PROVIDER "@SYMMETRIX_FOURIER_D3_PROVIDER@"
#define SYMMETRIX_FOURIER_D3_PROVIDER_VARIANT "@SYMMETRIX_FOURIER_D3_PROVIDER_VARIANT@"
#define SYMMETRIX_FOURIER_D3_KOKKOSFFT_VERSION "@SYMMETRIX_FOURIER_D3_KOKKOSFFT_VERSION@"
#define SYMMETRIX_FOURIER_D3_REASON "@SYMMETRIX_FOURIER_D3_REASON@"
